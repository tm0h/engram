{
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "user-own-hook --flag",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": ["Bash(pnpm:*)"]
  }
}

{
  "name": "engram-cli",
  "version": "0.2.0",
  "description": "A git-native memory tool for AI agents. Personal + team/project memory that any harness (Pi, Claude Code, cloud review bots) can use. Built with Effect.",
  "keywords": [
    "adr",
    "agent",
    "ai",
    "cli",
    "context",
    "decisions",
    "effect",
    "engram",
    "knowledge",
    "llm",
    "pi-package"
  ],
  "homepage": "https://github.com/tm0h/engram#readme",
  "bugs": {
    "url": "https://github.com/tm0h/engram/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tm0h/engram.git",
    "directory": "packages/cli"
  },
  "bin": {
    "engram": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vp pack",
    "prepack": "node -e \"require('fs').cpSync('../harnesses/src/pi/skills', 'skills', { recursive: true })\"",
    "prepublishOnly": "cp ../../README.md ./README.md",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^13.0.0",
    "effect": "catalog:",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@engram/core": "workspace:*",
    "@engram/harnesses": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./dist/pi-extension.js"
    ],
    "skills": [
      "./skills"
    ]
  }
}
